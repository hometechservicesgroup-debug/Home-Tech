# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file or paste these values into the website's frontend code.

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hometake
NODE_ENV=development

# ---- Twilio (OTP login) ----
# From Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# From Twilio Console → Verify → Services → (create a service) → Service SID
# This is DIFFERENT from your Account SID.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Razorpay (online payments) ----
# From Razorpay Dashboard → Settings → API Keys. Leave blank to disable online payments for now.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Set true in Render only while intentionally testing with rzp_test_ keys.
# Set false/remove before production payments; live keys work without this flag.
RAZORPAY_ALLOW_TEST_KEYS=false

# ---- Admin panel login ----
# Used ONLY the very first time the server starts, to create your admin account.
# After that, log in with these in admin.html and change them from the Account tab.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run

# The exact domain your website is hosted on (for CORS). Use * only while testing locally.
ALLOWED_ORIGIN=http://localhost:5500

PORT=4000

# Optional. Point this at a persistent disk mount in production (for example /var/data/uploads).
UPLOADS_DIR=
