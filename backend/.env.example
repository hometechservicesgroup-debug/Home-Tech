# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file or paste credentials into chat.

# ---- PostgreSQL ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hometake
NODE_ENV=development

# ---- Firebase phone OTP ----
# Web app config values from Firebase Console → Project settings → Your apps.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=1:000000000000:web:replace_with_app_id
# Firebase Console → Storage → bucket name (for example PROJECT_ID.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
# Service account JSON contents; backend only. Keep this secret in Render/backend env.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- PhonePe Payment Gateway ----
# PhonePe credentials are server-only. Production credentials require merchant approval/UAT.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_CLIENT_SECRET=
PUBLIC_SITE_URL=https://your-site.netlify.app

# ---- Admin login ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run

# Website origin (the exact Netlify domain).
ALLOWED_ORIGIN=http://localhost:5500
PORT=4000

# Optional persistent upload disk mount in production.
UPLOADS_DIR=
